{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CyoriaSMP-Team/ProtocolLib2PacketEvents/blob/main/compatibility/evidence-schema.json",
  "title": "ProtocolLib2PacketEvents evidence record",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "run_id",
    "started_at",
    "environment",
    "plugin",
    "result",
    "status_level",
    "checks",
    "artifact_sha256",
    "log_sha256"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "started_at": { "type": "string", "minLength": 1 },
    "stopped_at": { "type": ["string", "null"] },
    "environment": {
      "type": "object",
      "required": ["id", "server", "server_version", "java", "packetevents", "p2p"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "server": { "type": "string", "minLength": 1 },
        "server_version": { "type": "string", "minLength": 1 },
        "java": { "type": "string", "minLength": 1 },
        "packetevents": { "type": "string", "minLength": 1 },
        "p2p": { "type": "string", "minLength": 1 }
      }
    },
    "plugin": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "result": { "enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"] },
    "status_level": { "enum": ["BOOT", "CORE", "PACKET_BEHAVIOR", "FULLY_TESTED", "NOT_CERTIFIED"] },
    "checks": { "type": "object" },
    "artifact_sha256": { "type": ["string", "null"] },
    "log_sha256": { "type": ["string", "null"] }
  }
}
